
# ==========================================
# LMS / HR MANAGEMENT SYSTEM
# ==========================================

# PHP / Composer dependencies
vendor/
composer.phar
phpunit.phar
/phpunit.xml

# Node.js dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p12
*.pfx
*.crt

# Yii2 local configuration
# Keep templates in environments/dev and environments/prod
/backend/config/*-local.php
/frontend/config/*-local.php
/common/config/*-local.php
/console/config/*-local.php

# Other secret configuration
**/config/secrets.php

# Yii2 runtime
**/runtime/*
!**/runtime/.gitignore

# Generated web assets
**/web/assets/*
!**/web/assets/.gitignore

# Yii2 generated entry points
/frontend/web/index.php
/frontend/web/index-test.php
/frontend/web/robots.txt
/backend/web/index.php
/backend/web/index-test.php
/backend/web/robots.txt

# Local Yii2 executable files
/yii
/yii_test
/yii_test.bat

# User uploads (all modules)
**/uploads/

# Generated documents and temporary data
/tmp-pdf/
/tmp/
/temp/
/cache/
/coverage/

# Log files and temporary files
*.log
*.tmp
*.temp
*.cache
*.bak
*.swp
*.swo
*.pid

# Database files and backups
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.gz
*.dump
*.backup

# IDE and editor configuration
.idea/
.vscode/
nbproject/
.buildpath
.project
.settings/

# AI development assistants
.agents/
.codex/
.cursor/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Generated build output
/dist/
/build/
/.next/

# Vagrant local runtime
/.vagrant/

# Docker local overrides
docker-compose.override.yml
compose.override.yml

# Local development utilities
/generatePasswordHashadmin123
/security-

# Legacy debugging information
/Legacy_Code/**/debug_questions.txt

# Local PHPUnit/Codeception output
**/tests/_output/*
!**/tests/_output/.gitignore
